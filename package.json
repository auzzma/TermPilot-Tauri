{
  "name": "termpilot-tauri",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postinstall": "patch-package",
    "prepare:bridge": "node scripts/prepare-bridge-runtime.mjs",
    "prepare:dependencies": "node scripts/prepare-bundled-dependencies.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bridge": "node scripts/test-bridge-runtime.mjs",
    "release:validation": "bash scripts/build-release-validation.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run prepare:bridge && tauri build",
    "tauri:build:macos": "npm run prepare:bridge && tauri build --bundles app,dmg",
    "tauri:build:windows": "npm run prepare:bridge && tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "extract-zip": "^2.0.1",
    "patch-package": "^8.0.1",
    "tar": "^7.5.22",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
